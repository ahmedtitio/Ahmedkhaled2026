# مفتاح تشفير الجلسات — أنشئ واحداً بـ: openssl rand -hex 32
JWT_SECRET=""

# بيانات حساب الأدمن (يُنشئها seed تلقائيًا)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
